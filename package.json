{
  "name": "coding-agent-hud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Windows telemetry HUD for Claude Code and Codex",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": { "node": ">=22.12.0" }
}
